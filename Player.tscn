[gd_scene format=3 uid="uid://ckykro8alswth"]

[sub_resource type="GDScript" id="GDScript_aso7v"]
resource_name = "Player"
script/source = "extends CharacterBody3D

signal health_changed(current: float, max: float)
signal died

@export var move_speed: float = 5.0
@export var sprint_speed: float = 8.0
@export var jump_velocity: float = 4.5
@export var mouse_sensitivity: float = 0.003
@export var controller_look_sensitivity: float = 3.0
@export var max_health: float = 100.0

var gravity: float = ProjectSettings.get_setting(\"physics/3d/default_gravity\")
var current_health: float

@onready var head: Node3D = $Head
@onready var camera: Camera3D = $Head/Camera3D


func _ready() -> void:
	current_health = max_health
	add_to_group(\"players\")

	# Assumes this node's name was set to the owning peer's ID when spawned
	# (e.g. by MultiplayerSpawner). That's what ties authority to the right player.
	set_multiplayer_authority(str(name).to_int())

	if is_multiplayer_authority():
		camera.make_current()
		Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
	else:
		camera.current = false


## Called by the zombie (server-side only). Health changes are pushed to
## every client via RPC rather than MultiplayerSynchronizer, since this
## node's multiplayer authority is the owning player, not the server.
func take_damage(amount: float) -> void:
	if not multiplayer.is_server():
		return
	var new_health: float = max(current_health - amount, 0.0)
	_apply_health.rpc(new_health)


@rpc(\"any_peer\", \"call_local\", \"reliable\")
func _apply_health(new_health: float) -> void:
	current_health = new_health
	health_changed.emit(current_health, max_health)
	if current_health <= 0.0:
		died.emit()


func _unhandled_input(event: InputEvent) -> void:
	if not is_multiplayer_authority():
		return

	if event is InputEventMouseMotion and Input.mouse_mode == Input.MOUSE_MODE_CAPTURED:
		rotate_y(-event.relative.x * mouse_sensitivity)
		head.rotate_x(-event.relative.y * mouse_sensitivity)
		head.rotation.x = clamp(head.rotation.x, -1.4, 1.4)

	if event.is_action_pressed(\"ui_cancel\"):
		Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
	if event is InputEventMouseButton and Input.mouse_mode == Input.MOUSE_MODE_VISIBLE:
		Input.mouse_mode = Input.MOUSE_MODE_CAPTURED


func _physics_process(delta: float) -> void:
	if not is_multiplayer_authority():
		return

	# Controller right-stick look (mouse look is handled in _unhandled_input above)
	var look_vec := Input.get_vector(\"look_left\", \"look_right\", \"look_up\", \"look_down\")
	if look_vec != Vector2.ZERO:
		rotate_y(-look_vec.x * controller_look_sensitivity * delta)
		head.rotate_x(-look_vec.y * controller_look_sensitivity * delta)
		head.rotation.x = clamp(head.rotation.x, -1.4, 1.4)

	if not is_on_floor():
		velocity.y -= gravity * delta

	if Input.is_action_just_pressed(\"jump\") and is_on_floor():
		velocity.y = jump_velocity

	var input_dir := Input.get_vector(\"move_left\", \"move_right\", \"move_forward\", \"move_back\")
	var direction := (transform.basis * Vector3(input_dir.x, 0, input_dir.y)).normalized()
	var speed := sprint_speed if Input.is_action_pressed(\"sprint\") else move_speed

	if direction:
		velocity.x = direction.x * speed
		velocity.z = direction.z * speed
	else:
		velocity.x = move_toward(velocity.x, 0, speed)
		velocity.z = move_toward(velocity.z, 0, speed)

	move_and_slide()
"

