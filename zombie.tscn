[gd_scene format=3 uid="uid://c3cvvg1ger8cq"]

[sub_resource type="GDScript" id="GDScript_upfqb"]
resource_name = "Zombie"
script/source = "extends CharacterBody3D

enum State { APPROACHING, BREACHING, CHASING }

@export var move_speed: float = 3.0
@export var chase_speed: float = 3.5
@export var attack_range: float = 1.5
@export var attack_damage: float = 10.0
@export var attack_cooldown: float = 1.0
@export var breach_wait_time: float = 1.2

@onready var nav_agent: NavigationAgent3D = $NavigationAgent3D
@onready var animation_player: AnimationPlayer = $AnimationPlayer
@onready var breach_timer: Timer = $BreachTimer

var state: State = State.APPROACHING
var entry_point: Vector3
var target_player: Node3D = null
var can_attack: bool = true


## Call right after add_child() -- reads the window's spawn position and
## sets the nav-mesh destination it should path to before breaching.
func setup(window: Node3D) -> void:
	global_position = window.get_node(\"Position\").global_position
	entry_point = window.global_position
	nav_agent.target_position = entry_point


func _ready() -> void:
	if not multiplayer.is_server():
		set_physics_process(false)
		return
	breach_timer.wait_time = breach_wait_time
	breach_timer.one_shot = true
	breach_timer.timeout.connect(func(): state = State.CHASING)


func _physics_process(_delta: float) -> void:
	match state:
		State.APPROACHING:
			_process_approaching()
		State.BREACHING:
			pass # just waiting on breach_timer
		State.CHASING:
			_process_chasing()


## Pathfinds to the window's entry point through the (blocked-off but
## still nav-mapped) back area, same as the chase phase does.
func _process_approaching() -> void:
	if nav_agent.is_navigation_finished():
		velocity = Vector3.ZERO
		state = State.BREACHING
		if animation_player.has_animation(\"breach\"):
			animation_player.play(\"breach\")
		breach_timer.start()
		return

	var next_pos := nav_agent.get_next_path_position()
	var direction := (next_pos - global_position)
	direction.y = 0.0
	if direction.length() > 0.01:
		direction = direction.normalized()
		look_at(global_position + direction, Vector3.UP)

	velocity = direction * move_speed
	move_and_slide()


## Normal nav-agent chase once inside, targeting the nearest player.
func _process_chasing() -> void:
	target_player = _find_nearest_player()
	if target_player == null:
		velocity = Vector3.ZERO
		return

	if global_position.distance_to(target_player.global_position) <= attack_range:
		velocity = Vector3.ZERO
		_try_attack()
		return

	nav_agent.target_position = target_player.global_position
	var next_pos := nav_agent.get_next_path_position()
	var direction := (next_pos - global_position)
	direction.y = 0.0
	if direction.length() > 0.01:
		direction = direction.normalized()
		look_at(global_position + direction, Vector3.UP)

	velocity = direction * chase_speed
	if animation_player.has_animation(\"walk\") and animation_player.current_animation != \"walk\":
		animation_player.play(\"walk\")
	move_and_slide()


func _find_nearest_player() -> Node3D:
	var players := get_tree().get_nodes_in_group(\"players\")
	var closest: Node3D = null
	var closest_dist := INF
	for p in players:
		var d := global_position.distance_to(p.global_position)
		if d < closest_dist:
			closest_dist = d
			closest = p
	return closest


func _try_attack() -> void:
	if not can_attack:
		return
	can_attack = false
	print(\"Zombie attacking \", target_player.name, \" for \", attack_damage)
	if target_player.has_method(\"take_damage\"):
		target_player.take_damage(attack_damage)
	if animation_player.has_animation(\"attack\"):
		animation_player.play(\"attack\")
	await get_tree().create_timer(attack_cooldown).timeout
	can_attack = true
"

