[gd_scene format=3 uid="uid://bh1x74de1dmf1"]

[sub_resource type="GDScript" id="GDScript_g7b7a"]
resource_name = "SpawnManager"
script/source = "extends Node

const SPAWN_GROUP := \"ZombieSpawn\"

## Assign your zombie PackedScene here, and also add it to the
## MultiplayerSpawner's \"Auto Spawn List\" in the Inspector.
@export var zombie_scene: PackedScene

@onready var multiplayer_spawner: MultiplayerSpawner = $MultiplayerSpawner
@onready var zombies_container: Node3D = $Zombies


## Finds every window in the ZombieSpawn group whose parent node is
## named room_name. This is what makes rooms \"automatic\" -- a window
## belongs to whichever room container it's placed under in the map.
func get_windows_in_room(room_name: String) -> Array:
	var all_windows := get_tree().get_nodes_in_group(SPAWN_GROUP)
	return all_windows.filter(func(w): return w.get_parent().name == room_name)


func spawn_zombie_in_room(room_name: String) -> Node:
	if not multiplayer.is_server():
		return null

	if room_name.is_empty():
		push_warning(\"SpawnManager: no room_name given\")
		return null

	var candidates := get_windows_in_room(room_name)
	if candidates.is_empty():
		push_warning(\"SpawnManager: no windows found under a node named '%s'\" % room_name)
		return null

	var window: Node3D = candidates.pick_random()
	var zombie := zombie_scene.instantiate()
	zombies_container.add_child(zombie, true)
	zombie.setup(window)
	return zombie
"

[node name="SpawnManager" type="Node" unique_id=893123325]
script = SubResource("GDScript_g7b7a")

[node name="MultiplayerSpawner" type="MultiplayerSpawner" parent="." unique_id=783271041]
spawn_path = NodePath("../Zombies")

[node name="Zombies" type="Node3D" parent="." unique_id=713295376]
