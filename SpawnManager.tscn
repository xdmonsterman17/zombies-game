[gd_scene format=3 uid="uid://bh1x74de1dmf1"]

[sub_resource type="GDScript" id="GDScript_g7b7a"]
resource_name = "SpawnManager"
script/source = "extends Node

## Assign your zombie PackedScene here, and also add it to the
## MultiplayerSpawner's \"Auto Spawn List\" in the Inspector.
@export var zombie_scene: PackedScene

## Optional: set in the Inspector for quick testing so you can call
## spawn_zombie_in_room() without an argument. Leave blank in normal play.
@export var default_room: String = \"\"

@onready var multiplayer_spawner: MultiplayerSpawner = $MultiplayerSpawner
@onready var zombies_container: Node3D = $Zombies

# room_name (String) -> Array[Node3D] of ZombieWindowSpawn instances
var rooms: Dictionary = {}


## Call when a room gets unlocked (door opened, key found, etc.) to add
## its windows to the spawn pool.
func unlock_room(room_name: String, spawn_points: Array) -> void:
	rooms[room_name] = spawn_points


## Call if a room should stop spawning zombies (locked back off, cleared
## for the round, etc.).
func lock_room(room_name: String) -> void:
	rooms.erase(room_name)


func spawn_zombie_in_room(room_name: String = default_room) -> void:
	if not multiplayer.is_server():
		return

	if room_name.is_empty():
		push_warning(\"SpawnManager: no room_name given and no default_room set\")
		return

	if not rooms.has(room_name):
		push_warning(\"SpawnManager: no room registered called '%s'\" % room_name)
		return

	var candidates: Array = rooms[room_name]
	if candidates.is_empty():
		push_warning(\"SpawnManager: no enabled spawn points in room '%s'\" % room_name)
		return

	var window: Node3D = candidates.pick_random()
	var zombie := zombie_scene.instantiate()
	zombie.global_position = window.get_node(\"Position\").global_position
	zombies_container.add_child(zombie, true)
	print(\"Func ran\")


func _on_timer_timeout() -> void:
	spawn_zombie_in_room(\"SpawnRoom\")
"

[node name="SpawnManager" type="Node" unique_id=893123325]
script = SubResource("GDScript_g7b7a")

